# Salin file ini menjadi .env lalu isi nilainya.
# File .env TIDAK BOLEH masuk ke git (sudah masuk .gitignore).
PORT=3000
NODE_ENV=development

# MySQL — sesuaikan dengan instalasi lokal kalian.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=workout_tracker

# Gemini API — kunci untuk endpoint rekomendasi premium (butir 5 UTS).
GEMINI_API_KEY=ganti_dengan_api_key_kalian
GEMINI_MODEL=gemini-1.5-flash
# Batas waktu panggilan Gemini (ms). Lewat ini -> jawaban 504 + fallback DB.
GEMINI_TIMEOUT_MS=8000

# Estimasi kalori: asumsi detik per repetisi utk gerakan berbasis set
# (dipakai workoutLogController saat durasi_menit tidak diisi).
DETIK_PER_REP=3
