        {
          "name": "POST /users - registrasi VALID (uji strip isAdmin & is_premium)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users",
            "body": {
              "mode": "raw",
              "raw": "{\"nama\":\"  Rangga  Latih  \",\"email\":\"reg-{{$timestamp}}@test.com\",\"password\":\"password123\",\"berat_badan\":68.5,\"tinggi_badan\":170,\"isAdmin\":true,\"is_premium\":true}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"is_premium DIPAKSA false walau body minta true\", () => pm.expect(j.data.is_premium).to.eql(false));",
                  "pm.test(\"isAdmin TIDAK tersimpan / tidak muncul\", () => pm.expect(j.data).to.not.have.property(\"isAdmin\"));",
                  "pm.test(\"password TIDAK pernah dibocorkan\", () => pm.expect(j.data).to.not.have.property(\"password\"));",
                  "pm.test(\"nama ternormalisasi (spasi rapi)\", () => pm.expect(j.data.nama).to.eql(\"Rangga Latih\"));",
                  "pm.test(\"ada header Location\", () => pm.response.to.have.header(\"Location\"));",
                  "pm.collectionVariables.set(\"userId\", j.data.id);",
                  "pm.collectionVariables.set(\"userEmail\", j.data.email);"
                ]
              }
            }
          ]
        },
