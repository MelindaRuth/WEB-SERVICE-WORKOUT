    {
      "name": "03 - Workout Logs",
      "item": [
        {
          "name": "POST /workout-logs - set+repetition (chaining)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/v1/workout-logs",
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\":\"{{premiumUserId}}\",\"tanggal\":\"2026-10-07\",\"catatan\":\"sesi pagi\",\"details\":[{\"exercise_id\":\"{{exerciseId}}\",\"set\":3,\"repetition\":12}]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"total_kalori dihitung service (> 0)\", () => pm.expect(Number(j.data.total_kalori)).to.be.above(0));",
                  "pm.test(\"kolom PIVOT 'set' terbaca\", () => pm.expect(j.data.exercises[0].WorkoutDetail.set).to.eql(3));",
                  "pm.test(\"jumlah_gerakan virtual = 1\", () => pm.expect(j.data.jumlah_gerakan).to.eql(1));",
                  "pm.collectionVariables.set(\"logId\", j.data.id);"
                ]
              }
            }
          ]
        },
