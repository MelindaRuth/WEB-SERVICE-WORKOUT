                  "if ([502,504].includes(pm.response.code)) { const j = pm.response.json(); pm.test(\"fallback database disertakan\", () => { pm.expect(j.data.sumber).to.eql(\"fallback_database\"); pm.expect(j.data.gerakan).to.be.an(\"array\"); }); }"
